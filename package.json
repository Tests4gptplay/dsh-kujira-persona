  "type": "module",
  "license": "CC-BY-NC-SA-4.0",
  "author": "Tests4gptplay",
  "homepage": "https://github.com/Tests4gptplay/dsh-kujira-persona#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tests4gptplay/dsh-kujira-persona.git"
  },
  "bugs": {
    "url": "https://github.com/Tests4gptplay/dsh-kujira-persona/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "persona",
    "gijinka",
    "鲸鱼娘",
