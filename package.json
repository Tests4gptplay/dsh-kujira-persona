{
  "name": "dsh-kujira-persona",
  "version": "2.0.0",
  "description": "DSH 人设与可选单只桌宠：模型联动、共享世界观、独立记忆与对话扩充",
  "type": "module",
  "license": "CC-BY-NC-SA-4.0",
  "author": "Tests4gptplay",
  "homepage": "https://github.com/Tests4gptplay/dsh-kujira-persona#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tests4gptplay/dsh-kujira-persona.git"
  },
  "bugs": {
    "url": "https://github.com/Tests4gptplay/dsh-kujira-persona/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "persona",
    "gijinka",
    "鲸鱼娘",
    "龙娘"
  ],
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client": "./pet/client.js"
  },
  "files": [
    "index.js",
    "dossier.js",
    "catalog.js",
    "cordis.patch.yml",
    "persona/*.md",
    "personas/*/*.md",
    "world/*.md",
    "instructions/README.md",
    "locale/*.json",
    "icon.svg",
    "assets/hero.svg",
    "LICENSE",
    "NOTICE.md",
    "README.md",
    "CHANGELOG.md",
    "pet/*.js",
    "pet/assets/*.svg",
    "pet/assets/*.png",
    "pet/native/win-x64/KujiraPet.exe",
    "pet/NOTICE.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ]
    }
  }
}
