{"action":"browser","code":"const evidence=join(home,'../evidence'); const {createHash}=await import('node:crypto'); const paths=['world/96-自补-世界观.md','persona/90-记忆.md','personas/stella/00-用户设定.md','personas/.kujira-catalog.json','world/88-外部试用.md']; const files=[]; for(const relative of paths){const content=await readFile(join(home,relative),'utf8'); files.push({relative,path:join(home,relative),content,sha256:createHash('sha256').update(content).digest('hex')});} await writeFile(join(evidence,'files-after.json'),JSON.stringify({readAt:new Date().toISOString(),files},null,2)); const escape=s=>String(s).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;'); const view=await page.context().newPage(); await view.setViewportSize({width:1500,height:1400}); await view.setContent('<!doctype html><meta charset="utf-8"><style>body{font-family:"Noto Sans CJK SC",sans-serif;background:#f4f6fa;color:#203040;padding:32px;line-height:1.6}h1{font-size:30px;margin-bottom:8px}p{font-size:17px}section{background:white;border:1px solid #d9e0e7;border-radius:10px;padding:18px 22px;margin:16px 0}h2{font-size:20px;margin:0 0 10px}pre{font-family:"Noto Sans CJK SC",monospace;font-size:16px;white-space:pre-wrap;overflow-wrap:anywhere;margin:0}small{font-size:11px;color:#667788}</style><h1>落盘文件核对</h1><p>以下内容直接读取自本次隔离 DSH 的真实文件。此页是测试证据排版，不是 DSH 设置界面。</p>'+files.map(f=>'<section><h2>'+escape(f.relative)+'</h2><pre>'+escape(f.content)+'</pre><small>SHA-256 '+f.sha256+'</small></section>').join('')); await view.screenshot({path:join(evidence,'files-after.png'),fullPage:true}); await view.close(); const bytes=await readFile(join(evidence,'files-after.png')); const response=await fetch('https://api.github.com/repos/'+process.env.GITHUB_REPOSITORY+'/contents/qa/screenshots/files-after.png',{method:'PUT',headers:{Authorization:'Bearer '+process.env.GH_TOKEN,Accept:'application/vnd.github+json','Content-Type':'application/json'},body:JSON.stringify({branch:'qa/ui-docs-rerun-20261023',message:'test evidence: actual saved files screenshot',content:bytes.toString('base64')})}); if(!response.ok)throw new Error('File screenshot publication failed: '+response.status); return {fileCount:files.length,files,screenshot:'files-after.png',screenshotBytes:bytes.length};"}
